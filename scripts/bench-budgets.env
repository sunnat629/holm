# Benchmark budgets: the only place the numbers live. Read by scripts/bench-gates.sh.
# Plain KEY=VALUE, no spaces, sourced by bash. Change a number only on purpose, in a reviewed
# commit that says why (docs/DECISIONS.md, C5).

# Unlock key derivation (one Argon2id run at KdfParams::DEFAULT, 256 MiB, 3 passes), in ms.
# The gate fails when the fastest of 5 runs is more than KDF_TOLERANCE_PCT away from the
# baseline in either direction: slower is a regression, much faster means the costs were
# weakened. The baseline is for the machine named below; record a new one on other hardware.
KDF_BASELINE_MS=356
KDF_TOLERANCE_PCT=25
KDF_BASELINE_MACHINE="Apple M3 Pro / Darwin 25.4.0"

# Search over 10,000 synthetic items, in ms. Two budgets, because the two cases differ: a typed
# query (the slower of a miss and a hit) and the empty query (it matches and sorts every item).
# TARGET is 10 ms for a typed query. Measured after Phase B on the baseline machine (min of 9):
# about 9.5 ms typed and 12.35 ms empty. The limits sit about 35% and 30% above those, so a real
# regression fails and a busy machine does not. See docs/DECISIONS.md, C5.
SEARCH_10K_TARGET_MS=10
SEARCH_10K_MAX_MS=13
SEARCH_10K_EMPTY_MAX_MS=16

# `holm --version`, median of 15 runs of the release binary, in ms.
STARTUP_MAX_MS=300
